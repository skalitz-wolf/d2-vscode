# 导入场景示例（scenarios + @ 导入）：场景的差异部分来自其他 .d2 文件
# 场景继承主板基础图，再把导入的内容叠加进来；导入支持整文件与选择性（"." 连到节点）
# 插件预览（--target=）只显示主板；看场景用 CLI：
#   d2 导入场景示例.d2 out                           → 渲染成目录（index + 每个场景一个 SVG）
#   d2 导入场景示例.d2 --target=scenarios.只加缓存 -  → 只渲染某个场景

# ── 基础图（所有场景共享）──
调用方: {shape: person; label: 短链使用方}
网关: {label: Sggate 统一网关}
AntURL: {label: AntURL 短链}
存储: {label: 缓存 / 数据库 / 日志}

调用方 -> 网关: GET 短链
网关 -> AntURL: 解析短链
AntURL -> 存储: 读写 {style.stroke-dash: 4}

# 场景用预览左上角的场景栏切换（基础 / 接入存储 / 只加缓存），不挂节点 .link

scenarios: {
  # 整文件导入：公共组件.d2 的三个存储节点整体叠加进本场景
  接入存储: @组件/公共组件

  # 选择性导入：只叠加 Redis 一个节点，再补场景自己的连线
  只加缓存: {
    缓存: @组件/公共组件.Redis 短链缓存
    AntURL -> 缓存: 1.先查缓存 {style.stroke-dash: 4}
    缓存 -> 网关: 2.命中返回 fullUrl {style.stroke-dash: 4}
  }
}
