# 导入场景图层示例（scenarios × layers 嵌套 + @ 导入）
# board 可以任意嵌套：场景里可以有图层，图层里也可以有场景
# 嵌套 board 的 --target 路径用 . 号连，如 scenarios.缓存命中.layers.存储细节
# 插件预览（--target=）只显示主板；嵌套 board 用 CLI 渲染：
#   d2 导入场景图层示例.d2 out
#   d2 导入场景图层示例.d2 --target=scenarios.缓存命中.layers.存储细节 -

# ── 基础图（所有场景共享）──
调用方: {shape: person; label: 短链使用方}
网关: {label: Sggate 统一网关}
AntURL: {label: AntURL 短链}

调用方 -> 网关: GET 短链
网关 -> AntURL: 解析短链

# 场景用预览左上角的场景栏切换（基础 / 缓存命中 / 缓存未命中）；
# 图层是节点内部细节，场景内的节点可以再 .link 到嵌套图层逐级下钻（见下方缓存.link）

scenarios: {
  缓存命中: {
    # 场景差异：命中链路（节点从 公共组件.d2 选择性导入）
    缓存: @组件/公共组件.Redis 短链缓存
    AntURL -> 缓存: 查缓存 {style.stroke-dash: 4}
    缓存 -> 网关: fullUrl {style.stroke-dash: 4}
    # 场景内节点 link 到本场景嵌套的图层：路径相对当前板写（写 scenarios.缓存命中.layers.存储细节 这种绝对形式会被 d2 静默丢弃）
    缓存.link: layers.存储细节

    # 场景内再嵌套图层，图层内容同样支持整文件导入
    layers: {
      服务内部: @组件/短链服务
      存储细节: @组件/公共组件
    }
  }

  缓存未命中: {
    失效页: {label: invalidTimeError.html 链接失效}
    AntURL -> 网关: "data=null（未找到/过期）" {style.stroke-dash: 4}
    网关 -> 失效页: 302 {style.stroke-dash: 4}
    失效页 -> 调用方: 展示"链接地址已过期" {style.stroke-dash: 4}
  }
}
